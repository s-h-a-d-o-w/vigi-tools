{
  "name": "vigi-tools",
  "version": "1.0.1",
  "description": "CLI tools for TP-Link VIGI cameras: sync recordings and switch motion detection by device presence",
  "homepage": "https://github.com/s-h-a-d-o-w/vigi-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-h-a-d-o-w/vigi-tools.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.ts",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "prepare": "husky",
    "typecheck": "tsc && pnpm -r typecheck"
  },
  "bin": {
    "vigi-tools": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0"
    }
  },
  "devDependencies": {
    "@s-h-a-d-o-w/oxlint-config": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "vigi",
    "tp-link",
    "camera",
    "rtsp",
    "motion-detection"
  ],
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
