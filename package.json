{
  "name": "vigi-tools",
  "version": "1.0.1",
  "description": "CLI tools for TP-Link VIGI cameras: sync recordings and switch motion detection by device presence",
  "homepage": "https://github.com/s-h-a-d-o-w/vigi-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-h-a-d-o-w/vigi-tools.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.ts",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "prepare": "husky",
    "typecheck": "tsc"
  },
  "bin": {
    "vigi-tools": "dist/cli.mjs"
  },
  "imports": {
    "#*": "./src/*"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0"
    }
  },
  "devDependencies": {
    "@s-h-a-d-o-w/oxlint-config": "^1.2.4",
    "@types/node": "^22.20.1",
    "esbuild": "^0.27.7",
    "husky": "^9.1.7",
    "knip": "^6.32.0",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "vigi",
    "tp-link",
    "camera",
    "rtsp",
    "motion-detection"
  ],
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
