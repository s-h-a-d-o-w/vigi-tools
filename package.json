{
  "name": "vigi-tools",
  "version": "1.2.2",
  "description": "CLI tools for TP-Link VIGI cameras: sync recordings and switch motion detection by device presence",
  "homepage": "https://github.com/s-h-a-d-o-w/vigi-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-h-a-d-o-w/vigi-tools.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "node ./src/cli/index.ts",
    "format": "oxfmt",
    "lint": "oxlint",
    "list-bluetooth-devices": "node ./scripts/list-bluetooth-devices.ts",
    "prepack": "pnpm build",
    "test": "vitest",
    "prepare": "husky",
    "typecheck": "tsc"
  },
  "bin": {
    "vigi-tools": "dist/cli/index.js"
  },
  "imports": {
    "#*": "./src/*"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1127.0",
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@s-h-a-d-o-w/oxlint-config": "^1.4.0",
    "@types/node": "^24.13.3",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "vigi",
    "tp-link",
    "camera",
    "rtsp",
    "motion-detection"
  ],
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
